# Signs session cookies. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# AI grading: set one key. AI_PROVIDER=auto uses Claude if its key is set, else Gemini, else mock.
AI_PROVIDER=auto
GEMINI_API_KEY=
# Cheapest by default. Switch to gemini-flash-latest or gemini-pro-latest for better (pricier) grading.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=
GEMINI_THINKING=low
ANTHROPIC_API_KEY=
GRADER_MODEL=claude-opus-5-5
AI_MOCK=0

DATABASE_URL=sqlite:///./grademate.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# Outgoing email. Leave SMTP_HOST empty to write emails to the in-app Outbox instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GradeMate <no-reply@example.com>
SMTP_STARTTLS=1
